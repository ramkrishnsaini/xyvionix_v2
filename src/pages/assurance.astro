---
/**
 * Assurance: the one page that explains why, what and how Xyvionix assures.
 *
 * The home page shows the idea. This page shows the working, and repeats
 * nothing from the home page: every figure and every section here is built
 * for this page alone.
 *
 * It reads as seven chapters, in the order a buyer asks:
 *   01 why       the evidence an enterprise holds, and what expires each item
 *   02 what      why six outcomes and not one score, then each area in detail
 *   03 how       one outcome followed through a change, the loop, who does what
 *   04 states    what moves an outcome from one state to the next
 *   05 receive   the four records the business holds, and what each leader can answer
 *   06 compare   one event, and what each practice does with it
 *   07 start     how to begin
 *
 * A chapter bar stays under the navigation so a reader can jump at any point.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Cta from '../components/layout/Cta.astro';
import AssuranceHero from '../components/assurance-page/AssuranceHero.astro';
import Chapters from '../components/assurance-page/Chapters.astro';
import AssuranceWhy from '../components/assurance-page/AssuranceWhy.astro';
import AssuranceSeparate from '../components/assurance-page/AssuranceSeparate.astro';
import AssuranceAreas from '../components/assurance-page/AssuranceAreas.astro';
import AssuranceJourney from '../components/assurance-page/AssuranceJourney.astro';
import AssuranceFlow from '../components/assurance-page/AssuranceFlow.astro';
import AssuranceResponsibility from '../components/assurance-page/AssuranceResponsibility.astro';
import AssuranceStates from '../components/assurance-page/AssuranceStates.astro';
import AssuranceRecords from '../components/assurance-page/AssuranceRecords.astro';
import AssuranceRoles from '../components/assurance-page/AssuranceRoles.astro';
import AssuranceCompare from '../components/assurance-page/AssuranceCompare.astro';
import AssuranceStart from '../components/assurance-page/AssuranceStart.astro';
import { staticPageContext } from '../lib/static-seo.ts';

const { page, seo, crumbs } = await staticPageContext('assurance');
---

<BaseLayout seo={seo} slug="assurance" pageType="hub" section="assurance">
  <AssuranceHero crumbs={crumbs} h1={page.h1} />

  <div class="ap">
    <Chapters />
    <AssuranceWhy />
    <AssuranceSeparate />
    <AssuranceAreas />
    <AssuranceJourney />
    <AssuranceFlow />
    <AssuranceResponsibility />
    <AssuranceStates />
    <AssuranceRecords />
    <AssuranceRoles />
    <AssuranceCompare />
    <AssuranceStart />
  </div>

  <Cta
    label="Next"
    title="Bring one outcome to the first conversation"
    text="It establishes what must be true, which evidence would prove it, and how the present state would be measured."
    location="hub-cta"
  />
</BaseLayout>

<style>
  /* Anchors stop below the chapter bar. The navigation is already allowed for in base.css. */
  .ap :global(.section[id]) {
    scroll-margin-top: 0.5rem;
  }
</style>
