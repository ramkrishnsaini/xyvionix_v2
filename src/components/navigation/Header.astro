---
/**
 * Primary navigation. "Assurance" is one control with one result: it opens the
 * panel. The overview page is the first link inside the panel.
 *
 * In the HTML the control is a plain link to the overview page, so it works
 * without script. With script it becomes a button that opens the panel.
 * Behaviour lives in src/scripts/site.ts.
 */
import { navCta, primaryNav } from '../../data/navigation.ts';
import Logo from '../layout/Logo.astro';
import Arrow from '../layout/Arrow.astro';

interface Props {
  /** Root-relative path of the current page, for aria-current. */
  currentPath: string;
  /** Slug of the section the page belongs to, so the right top-level item is marked. */
  section?: string;
}

const { currentPath, section } = Astro.props;

const isCurrent = (href: string) => href === currentPath;
const inSection = (href: string) => section !== undefined && href === `/${section}`;
---

<header class="nav" data-nav>
  <div class="shell nav__shell">
    <div class="nav__bar">
      <div class="nav__row">
        <a href="/" class="brand" aria-label="Xyvionix home">
          <Logo />
          <span>Xyvionix</span>
        </a>

        <nav aria-label="Primary">
          <ul class="nav__list">
            {
              primaryNav.map((item) => (
                <li class="nav__item">
                  {item.groups ? (
                    <a
                      href={item.href}
                      class="nav__link"
                      aria-current={isCurrent(item.href) ? 'page' : inSection(item.href) ? 'true' : undefined}
                      data-nav-disclose
                    >
                      {item.label}
                      <svg class="nav__caret" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true" focusable="false">
                        <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.2" />
                      </svg>
                    </a>
                  ) : (
                    <a
                      href={item.href}
                      class="nav__link"
                      aria-current={isCurrent(item.href) ? 'page' : inSection(item.href) ? 'true' : undefined}
                    >
                      {item.label}
                    </a>
                  )}
                  {item.groups && (
                    <>
                      <div class="nav__panel" id="nav-panel-assurance" data-nav-panel hidden>
                        <a href={item.href} class="nav__overview" aria-current={isCurrent(item.href) ? 'page' : undefined}>
                          <span>
                            <span class="nav__overview-title">Assurance overview</span>
                            <span class="nav__sub-desc">The six areas, and how they fit together</span>
                          </span>
                          <Arrow size="sm" />
                        </a>
                        <div>
                          <div class="nav__group">
                            <p class="nav__group-label">{item.groups[0]!.label}</p>
                            <ul class="nav__group-list">
                              {item.groups[0]!.links.map((link) => (
                                <li>
                                  <a href={link.href} class="nav__sub">
                                    {link.label}
                                    {link.description && <span class="nav__sub-desc">{link.description}</span>}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        </div>
                        <div>
                          {item.groups.slice(1).map((group) => (
                            <div class="nav__group">
                              <p class="nav__group-label">{group.label}</p>
                              <ul class="nav__group-list">
                                {group.links.map((link) => (
                                  <li>
                                    <a href={link.href} class="nav__sub">
                                      {link.label}
                                      {link.description && <span class="nav__sub-desc">{link.description}</span>}
                                    </a>
                                  </li>
                                ))}
                              </ul>
                            </div>
                          ))}
                        </div>
                      </div>
                    </>
                  )}
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="nav__actions">
          <a href="/search" class="nav__icon" aria-label="Search">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false">
              <circle cx="7.5" cy="7.5" r="5.25" stroke="currentColor" stroke-width="1.3" />
              <path d="M11.5 11.5 16 16" stroke="currentColor" stroke-width="1.3" />
            </svg>
          </a>
          <a href={navCta.href} class="btn btn--sm nav__cta" data-track="cta_click" data-track-location="nav">
            {navCta.label}
          </a>
          <button
            type="button"
            class="nav__icon nav__toggle"
            aria-expanded="false"
            aria-controls="nav-mobile"
            data-nav-toggle
          >
            <span class="sr-only">Menu</span>
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
              <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.4" />
            </svg>
          </button>
        </div>
      </div>

      <nav class="nav__mobile" id="nav-mobile" aria-label="Primary, mobile" data-nav-mobile hidden>
        <ul>
          {
            primaryNav.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
                {item.groups && (
                  <ul>
                    {item.groups
                      .flatMap((g) => g.links)
                      .map((link) => (
                        <li>
                          <a href={link.href} class="nav__msub" aria-current={isCurrent(link.href) ? 'page' : undefined}>
                            {link.label}
                          </a>
                        </li>
                      ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
        <a href={navCta.href} class="btn" data-track="cta_click" data-track-location="nav-mobile">
          {navCta.label}
        </a>
      </nav>
    </div>
  </div>
</header>

<style>
  .nav__item {
    display: flex;
    align-items: center;
  }
</style>
