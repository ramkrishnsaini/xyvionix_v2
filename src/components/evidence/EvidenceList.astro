---
/** Evidence required to hold an outcome, as numbered term and description rows. */
interface Props {
  items: { name: string; detail: string }[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <dl class="rows evidence rows--closed rv">
      {items.map((item) => (
        <div class="row">
          <dt class="row__term">{item.name}</dt>
          <dd class="row__desc">{item.detail}</dd>
        </div>
      ))}
    </dl>
  )
}
