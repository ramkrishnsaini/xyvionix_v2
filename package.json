{
  "name": "xyvionix-com",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "description": "Xyvionix — Continuous Technology Assurance. Production website.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/validate-content.mjs",
    "build": "astro build",
    "postbuild": "node scripts/build-headers.mjs && node scripts/validate-dist.mjs",
    "build:draft": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test \"tests/**/*.test.ts\"",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:dist": "node scripts/validate-dist.mjs --report",
    "status:content": "node scripts/content-status.mjs",
    "status:integrity": "node scripts/content-integrity.mjs",
    "report:review": "node scripts/review-report.mjs",
    "report:claims": "node scripts/claim-audit.mjs",
    "docs:generate": "node scripts/generate-docs.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "qa": "npm run test && npm run check && npm run build && npm run report:claims",
    "checkpoint": "node scripts/checkpoint.mjs",
    "docs:research": "node scripts/build-research-doc.mjs",
    "report:similarity": "node scripts/similarity.mjs",
    "report:final": "node scripts/final-report-numbers.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@resvg/resvg-js": "^2.6.2",
    "gray-matter": "^4.0.3",
    "satori": "^0.33.5",
    "typescript": "^6.0.3"
  }
}
