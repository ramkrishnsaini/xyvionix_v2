# Copy to .env for local use, and set the same variables in the host's environment.
# Nothing here is a secret that belongs in the repository. Leave a value empty if it
# does not exist yet: the site degrades gracefully and never invents one.

# HTTPS endpoint that receives the contact form POST. Until this is set, the form is
# rendered disabled. Its origin is added to the Content-Security-Policy automatically.
PUBLIC_CONTACT_ENDPOINT=

# Optional. Comma-separated https origins of an analytics provider, added to the
# Content-Security-Policy. Leave empty for no analytics.
PUBLIC_ANALYTICS_ORIGIN=

# Optional. IndexNow key generated in Bing Webmaster Tools. Set in the deploy
# environment only, used by scripts/indexnow.mjs after a production deploy.
INDEXNOW_KEY=

# Never set in production. Renders draft content for layout review.
# XYV_INCLUDE_DRAFTS=1
