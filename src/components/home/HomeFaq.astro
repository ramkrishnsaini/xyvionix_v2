---
/**
 * Questions on the home page, as collapsible panels.
 *
 * Designed from what a visitor does, in order:
 *   scan     questions are grouped by topic, one full-width row each
 *   decide   the direct answer sits under every question, always visible
 *   read     opening a row adds the detail and a link to go deeper
 *   compare  panels are independent: opening one never closes another
 *
 * Panels are native <details>, so they work with keyboard, screen reader and
 * find-in-page, and without JavaScript. Every answer is in the static HTML.
 * No FAQPage markup is emitted.
 */
import Section from '../layout/Section.astro';
import Arrow from '../layout/Arrow.astro';
import { homeFaqGroups } from '../../data/home-faq.ts';
import { site } from '../../data/site.ts';

const pad = (n: number) => String(n).padStart(2, '0');

let count = 0;
const groups = homeFaqGroups.map((group) => ({
  ...group,
  items: group.items.map((item) => {
    count += 1;
    return { ...item, n: pad(count), id: `question-${pad(count)}`, first: count === 1 };
  }),
}));
---

<Section surface="light" alt labelledby="faq-title">
  <div class="faq" data-faq>
    <div class="faq__side">
      <div class="faq__sticky rv">
        <p class="lbl">Questions</p>
        <h2 id="faq-title" class="h2 faq__title">What people ask before they talk to us</h2>
        <p class="body faq__lede">
          Plain answers on what Xyvionix takes responsibility for, what stays with your teams, and how an engagement
          begins.
        </p>
      </div>
    </div>

    <div class="faq__main">
      {
        groups.map((group, i) => (
          <div class="faq__group rv">
            <div class="faq__group-head">
              <h3 class="faq__group-title">{group.title}</h3>
              {i === 0 && (
                <button type="button" class="faq__all" data-faq-all aria-expanded="false" hidden>
                  <span class="ul" data-faq-all-label>Open all answers</span>
                </button>
              )}
            </div>
            <div class="faq__list">
              {group.items.map((item) => (
                <details class="faq__panel" id={item.id} open={item.first}>
                  <summary class="faq__sum" data-track="faq_toggle" data-track-location="home-faq">
                    <span class="faq__n num" aria-hidden="true">
                      {item.n}
                    </span>
                    <h4 class="faq__q">{item.q}</h4>
                    <span class="faq__short">{item.short}</span>
                    <span class="faq__icon" aria-hidden="true" />
                  </summary>
                  <div class="faq__body">
                    <p class="faq__a">{item.a}</p>
                    {item.link && (
                      <a
                        href={item.link.href}
                        class="lk lk--sm faq__more"
                        data-track="faq_click"
                        data-track-location="home-faq"
                      >
                        <span class="ul">{item.link.label}</span>
                        <Arrow size="sm" />
                      </a>
                    )}
                  </div>
                </details>
              ))}
            </div>
          </div>
        ))
      }

      <div class="faq__ask rv">
        <div>
          <p class="faq__ask-title">A question that is not here?</p>
          <p class="faq__ask-text">
            Bring it to the first conversation. It begins with one outcome your business needs to keep proven.
          </p>
        </div>
        <a href={site.cta.href} class="btn faq__ask-btn" data-track="cta_click" data-track-location="home-faq">
          {site.cta.label}
        </a>
      </div>
    </div>
  </div>
</Section>

<script>
  import '../../scripts/faq.ts';
</script>

<style>
  .faq {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 64rem) {
    .faq {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: 5rem;
      align-items: start;
    }

    .faq__side {
      height: 100%;
    }

    .faq__sticky {
      position: sticky;
      top: 7.5rem;
    }
  }

  .faq__title {
    margin-top: 1.5rem;
    max-width: 16ch;
  }

  .faq__lede {
    margin-top: 1.5rem;
    max-width: 40ch;
  }

  /* open or close everything */
  .faq__all {
    flex: none;
    margin-block: -0.4rem;
    padding: 0.4rem 0;
    line-height: 1.4;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--mut);
    cursor: pointer;
  }

  .faq__all:hover {
    color: var(--tx);
  }

  /* group */
  .faq__group + .faq__group {
    margin-top: 3rem;
  }

  /* the control shares the first title's line, so it costs no height */
  .faq__group-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--ln2);
  }

  .faq__group-title {
    line-height: 1.4;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--fnt);
  }

  /* panel */
  .faq__panel {
    border-bottom: 1px solid var(--ln);
    scroll-margin-top: 1rem;
    transition: background-color 0.25s var(--ease);
  }

  .faq__panel[open] {
    background: var(--bg0);
    box-shadow: inset 2px 0 0 var(--tx);
  }

  .faq__sum {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 1.25rem;
    row-gap: 0.4rem;
    align-items: start;
    padding: 1.35rem 1rem;
    list-style: none;
    cursor: pointer;
  }

  .faq__sum::-webkit-details-marker {
    display: none;
  }

  .faq__sum::marker {
    content: '';
  }

  .faq__sum:focus-visible {
    outline: 1.5px solid var(--tx);
    outline-offset: -1.5px;
  }

  .faq__n {
    display: none;
    padding-top: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: var(--track-label);
    color: var(--fnt);
  }

  .faq__q {
    grid-column: 1;
    grid-row: 1;
    font-size: clamp(1.0625rem, 1.02rem + 0.25vw, 1.219rem);
    font-weight: 550;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--tx);
  }

  .faq__short {
    grid-column: 1;
    grid-row: 2;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--mut);
    text-wrap: pretty;
  }

  .faq__icon {
    grid-column: 2;
    grid-row: 1 / span 2;
    position: relative;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--ln2);
    border-radius: 50%;
    transition:
      background-color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.75rem;
    height: 1.5px;
    margin: -0.75px 0 0 -0.375rem;
    background: var(--tx);
    transition:
      transform 0.3s var(--ease),
      background-color 0.2s var(--ease);
  }

  /* the upright bar of the plus lies down to make a minus */
  .faq__icon::after {
    transform: rotate(90deg);
  }

  .faq__panel[open] .faq__icon::after {
    transform: rotate(0deg);
  }

  .faq__sum:hover .faq__icon,
  .faq__panel[open] .faq__icon {
    background: var(--tx);
    border-color: var(--tx);
  }

  .faq__sum:hover .faq__icon::before,
  .faq__sum:hover .faq__icon::after,
  .faq__panel[open] .faq__icon::before,
  .faq__panel[open] .faq__icon::after {
    background: var(--bg0);
  }

  .faq__body {
    padding: 0 1rem 1.75rem;
  }

  .faq__a {
    padding-top: 1rem;
    border-top: 1px dashed var(--ln2);
    font-size: 0.969rem;
    line-height: 1.75;
    color: var(--tx);
    max-width: 64ch;
  }

  .faq__more {
    margin-top: 1.1rem;
  }

  @media (min-width: 40rem) {
    .faq__sum {
      grid-template-columns: 2.25rem minmax(0, 1fr) auto;
      padding: 1.6rem 1.5rem;
    }

    .faq__n {
      display: block;
      grid-column: 1;
      grid-row: 1;
    }

    .faq__q,
    .faq__short {
      grid-column: 2;
    }

    .faq__icon {
      grid-column: 3;
    }

    /* answer lines up under the question, not under the number */
    .faq__body {
      padding: 0 5rem 2rem 5rem;
    }
  }

  /* height eases open where the browser can animate to auto; elsewhere it opens at once */
  @media (prefers-reduced-motion: no-preference) {
    @supports (interpolate-size: allow-keywords) {
      .faq__panel {
        interpolate-size: allow-keywords;
      }

      .faq__panel::details-content {
        block-size: 0;
        overflow: clip;
        transition:
          block-size 0.32s var(--ease),
          content-visibility 0.32s allow-discrete;
      }

      .faq__panel[open]::details-content {
        block-size: auto;
      }
    }
  }

  /* closing prompt */
  .faq__ask {
    display: grid;
    gap: 1.5rem;
    margin-top: 3rem;
    padding: 1.75rem 1rem;
    border: 1px solid var(--ln2);
    border-radius: var(--radius-md);
    background: var(--bg0);
  }

  @media (min-width: 40rem) {
    .faq__ask {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 2.5rem;
      padding: 2rem 1.5rem;
    }
  }

  .faq__ask-title {
    font-size: 1.125rem;
    font-weight: 550;
    letter-spacing: -0.02em;
    color: var(--tx);
  }

  .faq__ask-text {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--mut);
    max-width: 48ch;
  }

  .faq__ask-btn {
    justify-self: start;
  }

  @media print {
    .faq__all,
    .faq__icon {
      display: none;
    }
  }
</style>
