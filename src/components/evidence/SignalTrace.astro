---
/**
 * Small illustrative signal traced against a threshold. The shape varies by
 * state so the four states are distinguishable by form, not colour.
 */
import type { AssuranceState } from '../../data/assurances.ts';

interface Props {
  state?: AssuranceState;
}

const { state = 'assured' } = Astro.props;

const traces: Record<AssuranceState, string> = {
  assured: '0,13 28,10 56,14 84,11 112,16 140,12 168,9 196,13 224,10 252,8 280,11',
  degrading: '0,8 28,9 56,8 84,11 112,10 140,13 168,14 196,15 224,17 252,17 280,18',
  risk: '0,10 28,11 56,13 84,16 112,19 140,22 168,24 196,23 224,25 252,24 280,26',
  unassured: '0,12 28,11 56,13 84,12 112,14',
};

const descriptions: Record<AssuranceState, string> = {
  assured: 'Illustrative signal holding above its threshold.',
  degrading: 'Illustrative signal moving toward its threshold.',
  risk: 'Illustrative signal that has crossed below its threshold.',
  unassured: 'Illustrative signal that stops: no current evidence.',
};
---

<div class="trace">
  <svg viewBox="0 0 280 30" role="img" aria-label={descriptions[state]} preserveAspectRatio="none">
    <line class="trace__threshold" x1="0" y1="19" x2="280" y2="19" stroke-dasharray="2.5 3"></line>
    <polyline class="trace__line" points={traces[state]}></polyline>
    {state === 'unassured' && <line class="trace__gap" x1="112" y1="14" x2="280" y2="14" stroke-dasharray="1 5" />}
  </svg>
</div>

<style>
  .trace {
    margin-top: 1.5rem;
  }

  .trace svg {
    width: 100%;
    height: 30px;
  }

  .trace__threshold {
    stroke: var(--gst);
    stroke-width: 1;
  }

  .trace__line {
    fill: none;
    stroke: var(--tx);
    stroke-width: 1.3;
    vector-effect: non-scaling-stroke;
  }

  .trace__gap {
    stroke: var(--fnt);
    stroke-width: 1;
  }

  .trace__note {
    margin-top: 0.5rem;
    font-size: 0.594rem;
  }
</style>
