---
/**
 * Chapter 5, first part: what the business actually holds. Four records,
 * each drawn as the record it is: the question it answers, the fields it
 * carries, and who reads it. All four are the enterprise's property.
 */
import Section from '../layout/Section.astro';
import SectionHead from '../layout/SectionHead.astro';
import Arrow from '../layout/Arrow.astro';
import { records } from '../../data/assurance-page.ts';

const pad = (n: number) => String(n).padStart(2, '0');
---

<Section surface="light" labelledby="receive-title" id="receive">
  <SectionHead
    label="05 · What you receive"
    title="Four records, and they are yours"
    id="receive-title"
    split
    text="Not a report of activity performed. Four records that stay current, are held where you decide, and remain your property in open formats, so that assurance can continue with or without Xyvionix."
  >
    <a href="/security-trust" class="lk rc__link">
      <span class="ul">Where the records are held</span>
      <Arrow />
    </a>
  </SectionHead>

  <div class="rc mt-block">
    {
      records.map((record, i) => (
        <article class="rc__card rv">
          <div class="rc__tab">
            <span class="rc__n num">Record {pad(i + 1)}</span>
            <span class="st st--sm st-assured" aria-hidden="true" />
          </div>
          <h3 class="rc__name">{record.name}</h3>
          <p class="rc__answers">{record.answers}</p>

          <ul class="rc__fields" aria-label={`What the ${record.name.toLowerCase()} holds`}>
            {record.fields.map((field) => (
              <li>
                <span>{field}</span>
                <span class="rc__rule" aria-hidden="true" />
              </li>
            ))}
          </ul>

          <div class="rc__for">
            <p class="rc__key">Read by</p>
            <p class="rc__who">{record.usedBy}</p>
          </div>
        </article>
      ))
    }
  </div>
</Section>

<style>
  .rc__link {
    margin-top: 1.75rem;
  }

  .rc {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 44rem) {
    .rc {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  @media (min-width: 76rem) {
    .rc {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .rc__card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1.5rem;
    border: 1px solid var(--ln2);
    border-radius: var(--radius-md);
    background: var(--bg1);
    transition: transform 0.55s var(--ease);
  }

  @media (min-width: 64rem) {
    .rc__card {
      padding: 1.75rem;
    }
  }

  .rc__tab {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--ln2);
  }

  .rc__n,
  .rc__key {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--fnt);
  }

  .rc__name {
    margin-top: 1.25rem;
    font-size: clamp(1.25rem, 1.2rem + 0.3vw, 1.4375rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  .rc__answers {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--mut);
  }

  /* the fields of the record, each with the line its value is written on */
  .rc__fields {
    display: grid;
    gap: 0.7rem;
    margin-block: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.4;
    letter-spacing: 0.02em;
    color: var(--tx);
  }

  .rc__fields li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .rc__rule {
    flex: 1;
    min-width: 1.5rem;
    border-bottom: 1px dashed var(--gst);
  }

  .rc__for {
    margin-top: auto;
    padding-top: 1.1rem;
    border-top: 1px dashed var(--ln2);
  }

  .rc__who {
    margin-top: 0.4rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--mut);
  }

  @supports (grid-template-rows: subgrid) {
    .rc__card {
      display: grid;
      grid-row: span 5;
      grid-template-rows: subgrid;
      row-gap: 0;
    }

    .rc__for {
      margin-top: 0;
      align-self: end;
    }
  }
</style>
