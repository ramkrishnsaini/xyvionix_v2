---
/**
 * The assurance evidence field from the frozen theme: a confidence trace
 * against a required threshold. Illustrative, and labelled as such in the
 * graphic and in the caption. The explanation is repeated in HTML so nothing
 * is conveyed by the SVG alone.
 */
interface Props {
  /** Unique prefix for ids when the figure is used more than once on a page. */
  idPrefix?: string;
  caption?: boolean;
}

const { idPrefix = 'field', caption = true } = Astro.props;
const titleId = `${idPrefix}-title`;
const descId = `${idPrefix}-desc`;
const trace =
  'M40 128 C110 112, 150 120, 200 126 C260 133, 296 152, 340 190 C376 220, 404 206, 444 174 C492 136, 550 128, 610 122 C670 117, 720 116, 760 114';
---

<figure class="hero__figure rv in">
  <div class="glass field">
    <svg viewBox="0 0 800 360" role="img" aria-labelledby={`${titleId} ${descId}`}>
      <title id={titleId}>Assurance evidence field, illustrative</title>
      <desc id={descId}>
        A confidence trace measured against a dashed required threshold. Solid square marks show verifications. Where the
        trace crosses below the threshold, assurance is lost, and corrective action restores it.
      </desc>

      <line class="field__axis" x1="40" y1="300" x2="760" y2="300"></line>
      <line class="field__axis" x1="40" y1="40" x2="40" y2="300"></line>
      <line class="field__grid" x1="40" y1="118" x2="760" y2="118"></line>
      <line class="field__grid" x1="40" y1="224" x2="760" y2="224"></line>

      <line class="field__threshold" x1="40" y1="178" x2="760" y2="178" stroke-dasharray="3 4"></line>
      <text class="field__mono field__faint" x="40" y="168">REQUIRED THRESHOLD</text>

      <path class="field__area" d={trace} transform="translate(0,10)"></path>
      <path class="field__trace ln-draw" d={trace}></path>

      <g class="field__proof">
        <rect x="106" y="107" width="7" height="7"></rect>
        <rect x="196" y="121" width="7" height="7"></rect>
        <rect x="440" y="169" width="7" height="7"></rect>
        <rect x="546" y="123" width="7" height="7"></rect>
        <rect x="676" y="112" width="7" height="7"></rect>
      </g>

      <rect class="field__breach" x="334" y="184" width="11" height="11"></rect>
      <line class="field__lead" x1="340" y1="196" x2="340" y2="252" stroke-dasharray="2 3"></line>
      <text class="field__mono field__muted" x="348" y="250">CORRECTIVE ACTION</text>
      <text class="field__mono field__muted" x="332" y="86" text-anchor="end">ASSURANCE LOST</text>
      <line class="field__lead" x1="340" y1="90" x2="340" y2="180" stroke-dasharray="2 3"></line>

      <g transform="translate(40,332)">
        <rect class="field__proof" x="0" y="-8" width="8" height="8"></rect>
        <text class="field__sans field__strong" x="16" y="0">Assured</text>
        <text class="field__sans field__faint" x="86" y="0">· illustrative model, not live data</text>
      </g>
      <text class="field__mono field__faint" x="760" y="332" text-anchor="end">EVIDENCE · THRESHOLD · STATE</text>
    </svg>
  </div>
  {
    caption && (
      <figcaption class="hero__caption">
        Illustrative model, not live data. Evidence is tested against an agreed threshold. When the trace falls below
        it, assurance is lost and corrective action continues until re-testing shows the outcome is met again.
      </figcaption>
    )
  }
</figure>

<style>
  .field {
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }

  .field__axis {
    stroke: var(--ln2);
    stroke-width: 1;
  }

  .field__grid {
    stroke: var(--ln);
    stroke-width: 1;
  }

  .field__threshold,
  .field__lead {
    stroke: var(--fnt);
    stroke-width: 1;
  }

  .field__area {
    fill: var(--ln);
    stroke: none;
    opacity: 0.6;
  }

  .field__trace {
    fill: none;
    stroke: var(--tx);
    stroke-width: 1.6;
  }

  .field__proof {
    fill: var(--tx);
  }

  .field__breach {
    fill: none;
    stroke: var(--tx);
    stroke-width: 1.6;
  }

  .field__mono {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 1px;
  }

  .field__sans {
    font-family: var(--font-sans);
    font-size: 13px;
  }

  .field__faint {
    fill: var(--fnt);
  }

  .field__muted {
    fill: var(--mut);
  }

  .field__strong {
    fill: var(--tx);
  }
</style>
